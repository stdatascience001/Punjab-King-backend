<?xml version="1.0" encoding="UTF-8"?>
<!--
  This makes IIS act as a reverse proxy for the "backend" application, forwarding every
  request it receives to the Node.js API process (started separately via the apps/api
  workspace's dev or start script, listening on the port from apps/api/.env's PORT,
  default 4000) instead of trying to serve this folder's files as static content.

  Requires (one-time IIS setup, cannot be done via this file):
    1. Install the "URL Rewrite" module (Microsoft).
    2. Install "Application Request Routing" (ARR) (Microsoft).
    3. In IIS Manager, click the SERVER node (top of the tree, not the site) -> open
       "Application Request Routing Cache" -> in the Actions pane click "Server Proxy
       Settings..." -> check "Enable proxy" -> Apply.
  Without step 3, URL Rewrite's "Rewrite" action here will fail (proxying is off by default).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNodeBackend" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:4000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
