# apps/api reads its .env from the current working directory at runtime (dotenv.config()
# with no path). Since `npm run dev`/`start --workspace=apps/api` runs with that folder as
# the cwd, the real .env file must live here — apps/api/.env — not at the repo root.
# On Render (or any host where env vars are set via the dashboard), you don't need this file
# at all — process.env is already populated and dotenv.config() silently no-ops.

# Server
PORT=4000
NODE_ENV=production
API_PREFIX=/api/v1
CORS_ORIGIN=https://your-frontend-domain.onrender.com

# Database (PostgreSQL) — from your live/managed Postgres instance
DATABASE_URL=postgresql://username:password@host:5432/pb_exchange?sslmode=require

# Redis — from your live/managed Redis instance
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# JWT — generate a real random secret for production, never reuse the dev default
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=1d
